{
	"name": "time-machine",
	"version": "26.9.0",
	"description": "Build tooling for the Time Machine plugin.",
	"private": true,
	"license": "GPL-3.0-or-later",
	"scripts": {
		"build": "npm run build:block && npm run build:css && npm run build:js",
		"build:block": "wp-scripts build blocks/time-machine/src/index.js --output-path=blocks/time-machine/build --webpack-copy-php",
		"postbuild:block": "node -e \"require('fs').copyFileSync('blocks/time-machine/src/block.json','blocks/time-machine/build/block.json')\"",
		"build:css": "sass assets/scss/time-machine.scss:assets/css/time-machine.css --style=compressed --no-source-map",
		"build:js": "terser assets/js/frontend-refresh.js --compress --mangle --output assets/js/frontend-refresh.min.js",
		"start": "wp-scripts start blocks/time-machine/src/index.js --output-path=blocks/time-machine/build --webpack-copy-php",
		"prestart": "node -e \"require('fs').mkdirSync('blocks/time-machine/build',{recursive:true});require('fs').copyFileSync('blocks/time-machine/src/block.json','blocks/time-machine/build/block.json')\"",
		"watch:css": "sass --watch assets/scss/time-machine.scss:assets/css/time-machine.css --no-source-map",
		"lint:js": "wp-scripts lint-js",
		"lint:css": "wp-scripts lint-style"
	},
	"devDependencies": {
		"@wordpress/scripts": "^34.1.0",
		"sass": "^1.102.0",
		"terser": "^5.51.2"
	}
}
